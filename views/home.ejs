<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - ShopNow</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <nav>
      <div class="logo">ShopNow</div>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products">Products</a></li>
      </ul>
      <div class="hamburger">☰</div>
    </nav>
  </header>

  <main>
    <section class="hero">
      <h1>Welcome to ShopNow</h1>
      <p>Best products at best prices</p>
      <a href="/products" class="btn">Shop Now</a>
    </section>

    <section class="featured">
      <h2 class="page-title">Featured Products</h2>
      <div class="product-grid">
        <% products.forEach(product => { %>
          <div class="product-card">
            <img src="<%= product.image %>" alt="<%= product.name %>">
            <h3><%= product.name %></h3>
            <p class="price">Rs. <%= product.price %></p>
            <a href="/products/<%= product._id %>" class="btn">View Details</a>
          </div>
        <% }) %>
      </div>
    </section>
  </main>

  <footer>
    <p>&copy; 2025 ShopNow</p>
  </footer>
</body>
</html>