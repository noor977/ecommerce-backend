<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> - ShopNow</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header>
    <nav>
      <div class="logo">ShopNow</div>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products">Products</a></li>
        <% if (user) { %>
          <% if (user.role === 'admin') { %>
            <li><a href="/admin/add-product">Add Product</a></li>
          <% } %>
          <li><a href="/logout">Logout (<%= user.name %>)</a></li>
        <% } else { %>
          <li><a href="/login">Login</a></li>
          <li><a href="/signup">Sign Up</a></li>
        <% } %>
      </ul>
      <div class="hamburger">☰</div>
    </nav>
  </header>

  <main>
    <div class="product-detail">
      <img src="<%= product.image %>" alt="<%= product.name %>">
      <div class="product-info">
        <h2><%= product.name %></h2>
        <p class="category-tag"><%= product.category %></p>
        <p class="price">Rs. <%= product.price %></p>
        <p class="description"><%= product.description %></p>
        <p class="stock">
          <% if (product.stock > 0) { %>
            In Stock: <%= product.stock %> items
          <% } else { %>
            Out of Stock
          <% } %>
        </p>
        <button class="btn">Add to Cart</button>
        <a href="/products" class="btn-outline">Back to Products</a>
      </div>
    </div>
  </main>

  <footer>
    <p>&copy; 2025 ShopNow</p>
  </footer>

</body>
</html>
