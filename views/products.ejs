<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products - ShopNow</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header>
    <nav>
      <div class="logo">ShopNow</div>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products">Products</a></li>
        <% if (user) { %>
          <% if (user.role === 'admin') { %>
            <li><a href="/admin/add-product">Add Product</a></li>
          <% } %>
          <li><a href="/logout">Logout (<%= user.name %>)</a></li>
        <% } else { %>
          <li><a href="/login">Login</a></li>
          <li><a href="/signup">Sign Up</a></li>
        <% } %>
      </ul>
      <div class="hamburger">☰</div>
    </nav>
  </header>

  <main>
    <h2 class="page-title">All Products</h2>

    <div class="search-container">
      <form action="/products" method="GET">
        <input
          type="text"
          name="search"
          placeholder="Search products..."
          value="<%= searchQuery %>"
        />
        <select name="category">
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= categoryQuery === cat ? 'selected' : '' %>>
              <%= cat %>
            </option>
          <% }) %>
        </select>
        <button type="submit" class="btn">Search</button>
      </form>
    </div>

    <div class="product-grid">
      <% if (products.length === 0) { %>
        <p class="no-results">No products found.</p>
      <% } else { %>
        <% products.forEach(product => { %>
          <div class="product-card">
            <img src="<%= product.image %>" alt="<%= product.name %>">
            <h3><%= product.name %></h3>
            <p class="category-tag"><%= product.category %></p>
            <p class="price">Rs. <%= product.price %></p>
            <a href="/products/<%= product._id %>" class="btn">View Details</a>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div class="pagination">
      <% for(let i = 1; i <= totalPages; i++) { %>
        <a href="/products?page=<%= i %>&search=<%= searchQuery %>&category=<%= categoryQuery %>"
           class="<%= currentPage === i ? 'active' : '' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
  </main>

  <footer>
    <p>&copy; 2025 ShopNow</p>
  </footer>

</body>
</html>
